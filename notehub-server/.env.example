# NoteHub Server 环境变量配置
# 复制此文件为 .env.local 用于本地开发

# Session 密钥（生产环境必须修改！）
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# 上传文件大小限制（MB）
MAX_FILE_SIZE="10"

# 应用配置
NODE_ENV="production"
PORT="6001"

# 主站地址（"返回官网"链接，可选）
NEXT_PUBLIC_MAIN_SITE_URL="http://139.155.142.76:3000"
