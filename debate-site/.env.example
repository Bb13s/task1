# NoteHub 环境变量配置
# 复制此文件为 .env.local 用于本地开发
# 在服务器上复制为 .env 并填入实际值

# 数据库配置
DATABASE_URL="file:./data/notehub.db"

# Session 密钥（生产环境必须修改！）
# 生成随机字符串：openssl rand -base64 32
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# 上传文件大小限制（MB）
MAX_FILE_SIZE="10"

# 应用配置
NODE_ENV="production"
PORT="3000"

# 可选：对象存储配置（后期扩展用）
# OSS_REGION="oss-cn-beijing"
# OSS_BUCKET="notehub-files"
# OSS_ACCESS_KEY_ID=""
# OSS_ACCESS_KEY_SECRET=""
